# Gemini API key - used ONLY on the server, never exposed to the browser
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.1-pro-preview)
# GEMINI_MODEL=gemini-3.1-pro-preview
# Optional: max AI requests per IP per hour (default: 30)
# AI_RATE_LIMIT_PER_HOUR=30

# Database Configuration (optional; falls back to local SQLite)
# DATABASE_URL=postgres://user:password@host:port/dbname

# Session Secret - REQUIRED in production (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public app URL, required for OAuth redirects (e.g. https://cvtoai.onrender.com)
APP_URL=
